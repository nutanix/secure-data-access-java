<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nutanix.securedata</groupId>
    <artifactId>encrypted-backup-data-transport</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Encrypted Backup Data Transport</name>
    <description>Client-side Java SDK for encrypted backup data transport over secure VDisk read/write</description>
    <url>https://github.com/nutanix/secure-data-access-java</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Nutanix</name>
            <organization>Nutanix</organization>
            <organizationUrl>https://www.nutanix.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/nutanix/secure-data-access-java.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/nutanix/secure-data-access-java.git</developerConnection>
        <url>https://github.com/nutanix/secure-data-access-java</url>
    </scm>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          protobuf-java 3.25.8 fixes CVE-2024-7254 (GHSA-735f-pc8j-v9w8);
          it stays on the 3.25.x line, so the vendored stubs generated by
          protoc 3.25.x remain compatible (runtime >= protoc). Keep this at
          or above the protobuf-java version grpc pulls in (see grpc.version).
        -->
        <protobuf.version>3.25.8</protobuf.version>
        <!--
          grpc 1.75.0 fixes CVE-2025-55163 (GHSA-prj3-ccx8-p6x4) by bundling
          Netty 4.1.124.Final in grpc-netty-shaded. It depends on
          protobuf-java 3.25.8, matching protobuf.version above.
        -->
        <grpc.version>1.75.0</grpc.version>
        <protobuf.maven.plugin.version>0.6.1</protobuf.maven.plugin.version>
        <junit.jupiter.version>5.10.3</junit.jupiter.version>
        <!--
          Vendored, checked-in gRPC/protobuf stubs. The .proto is NOT shipped:
          it is regenerated locally into this folder (see the generate-proto
          profile) and committed, so the pipeline builds without protoc or the
          proto. Marked linguist-generated in .gitattributes so it is skipped
          in reviews.
        -->
        <generated.sources.dir>${project.basedir}/src/main/generated</generated.sources.dir>
    </properties>

    <dependencies>
        <!--
          Core gRPC API (Status, ManagedChannel, Metadata, CallCredentials, ...)
          referenced directly by the client. Pulled in transitively by grpc-stub
          and grpc-protobuf too, but declared explicitly since it is used directly.
        -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
        <!--
          gRPC-generated stubs reference javax.annotation.Generated, which was
          removed from the JDK in Java 9+. This (old javax namespace) jar
          provides it. The jakarta.* namespace does NOT satisfy the generated
          code, which uses javax.*, so only this dependency is needed.
        -->
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
          Test-only: netty's SelfSignedCertificate (used to stand up an in-process
          TLS gRPC server in end-to-end tests) generates its throwaway cert via
          BouncyCastle, since the JDK's sun.security.x509 path is encapsulated on
          Java 17+. Not shipped: test scope only.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.78.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <!--
              Detects ${os.detected.classifier}, used only when regenerating the
              proto (generate-proto profile). Harmless when that profile is off.
            -->
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!--
              The examples are added as a source root below so they compile (and
              can be run via exec:java), but they are sample code, not part of the
              SDK's API, so keep their compiled classes out of the published jar.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <excludes>
                        <exclude>com/nutanix/securedata/sdk/examples/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
              Lets the bundled examples be run from Maven against the freshly
              built classes, e.g.:
                mvn exec:java -Dexec.mainClass=com.nutanix.securedata.sdk.examples.BackupReadExample
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
            <!--
              Registers extra source roots on every build (both locally and in
              the pipeline):
                - src/main/generated: the vendored, checked-in proto stubs, so
                  the pipeline compiles them without ever running protoc.
                - examples/: sample programs kept outside src/main/java.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-generated-and-example-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${generated.sources.dir}</source>
                                <source>${project.basedir}/examples</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Attach a -sources.jar (required by Maven Central, useful for IDEs). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Attach a -javadoc.jar (required by Maven Central). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <!-- Generated stubs are not documented to strict Javadoc standards. -->
                    <doclint>none</doclint>
                    <failOnError>false</failOnError>
                    <quiet>true</quiet>
                    <!-- Keep protobuf/gRPC stubs out of the published JavaDocs. -->
                    <sourceFileExcludes>
                        <exclude>**/com/nutanix/api/dataprotection/streaming/v1/*.java</exclude>
                    </sourceFileExcludes>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Proto regeneration. Runs ONLY when src/main/proto/vdisk.proto is
          present on disk, which is true on a developer machine but never on the
          pipeline (the proto is .gitignore'd and not pushed). This is what lets
          a single pom build in both places: the pipeline finds no proto, so
          protoc is skipped and it just compiles the committed stubs.

          Regenerate locally after editing the proto with:
            mvn generate-sources        (auto-activates; writes src/main/generated)
        -->
        <profile>
            <id>generate-proto</id>
            <activation>
                <file>
                    <exists>src/main/proto/vdisk.proto</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.xolstice.maven.plugins</groupId>
                        <artifactId>protobuf-maven-plugin</artifactId>
                        <version>${protobuf.maven.plugin.version}</version>
                        <configuration>
                            <protocArtifact>
                                com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}
                            </protocArtifact>
                            <pluginId>grpc-java</pluginId>
                            <pluginArtifact>
                                io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}
                            </pluginArtifact>
                            <!-- Write both message and gRPC stubs into the committed folder. -->
                            <outputDirectory>${generated.sources.dir}</outputDirectory>
                            <!-- Both goals share one dir; don't wipe between them. -->
                            <clearOutputDirectory>false</clearOutputDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>compile</goal>
                                    <goal>compile-custom</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Release/publish to Maven Central. Off by default so ordinary local and
          pipeline builds need no GPG key or Central credentials. Activate with
          -Prelease on the deploy step.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.6.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
